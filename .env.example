# Transport Victoria Open Data API key
# Register at https://opendata.transport.vic.gov.au → Login → profile
OPENDATA_VIC_API_KEY=your-api-key-here

# Mapbox access token
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Server
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# Polling — 15s against a ~30s server-side cache
POLL_INTERVAL_MS=15000
BROADCAST_INTERVAL_MS=1000
STALE_VEHICLE_THRESHOLD_MS=120000
