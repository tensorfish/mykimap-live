{
  "name": "mykimap",
  "private": true,
  "workspaces": ["packages/*", "docs"],
  "scripts": {
    "dev": "PROJECT_ROOT=$PWD bun run --filter '*' dev",
    "dev:server": "PROJECT_ROOT=$PWD bun run --filter server dev",
    "dev:client": "PROJECT_ROOT=$PWD bun run --filter client dev",
    "dev:docs": "PROJECT_ROOT=$PWD bun run --filter docs dev",
    "build": "PROJECT_ROOT=$PWD bun run build:client && PROJECT_ROOT=$PWD bun run build:server",
    "build:server": "PROJECT_ROOT=$PWD bun run --filter server build",
    "build:client": "PROJECT_ROOT=$PWD bun run --filter client build",
    "build:docs": "PROJECT_ROOT=$PWD bun run --filter docs build",
    "start": "PROJECT_ROOT=$PWD bun run packages/server/dist/index.js",
    "typecheck": "PROJECT_ROOT=$PWD bun run --filter '*' typecheck",
    "generate-snapshot": "PROJECT_ROOT=$PWD bun run packages/tools/src/generate-snapshot.ts"
  }
}
